[user]
	name = Tanky Woo
	email = wtq1990@gmail.com
[push]
	; for git 1.8
	default = simple
[core]
	editor = vim
	excludesfile = /home/tankywoo/.gitignore
	quotepath = false
	pager = delta
[diff]
	tool = vimdiff
[merge]
	tool = vimdiff
	conflictStyle = zdiff3
[difftool]
	prompt = false

[alias]
	st = status
	l = log --pretty=oneline -n 20 --graph --abbrev-commit
	ll = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --
	la = log --color --graph --oneline --decorate --all --
	b = branch
	ci = commit -v
	ca = commit -a -v
	pl = pull
	ps = push
	co = checkout
	df = diff
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --

; ; https://github.com/git/git/tree/master/contrib/diff-highlight
; [pager]
; 	#log = diff-highlight | less
; 	#show = diff-highlight | less
; 	#diff = diff-highlight | less
; 	log = diff-so-fancy | less
; 	show = diff-so-fancy | less
; 	diff = diff-so-fancy | less

[interactive]
	# diffFilter = diff-highlight | less
	# diffFilter = diff-so-fancy --patch
	diffFilter = delta --color-only

[color]
	ui = true
[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green
[color "diff"]
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
	func = 146 bold
	commit = yellow bold
	whitespace = red reverse
[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[delta]
	navigate = true
	side-by-side = true
	line-numbers = true
	diff-so-fancy = true

[http]
	proxy = http://127.0.0.1:7897
[https]
	proxy = https://127.0.0.1:7897
